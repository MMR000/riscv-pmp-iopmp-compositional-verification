[options]
mode bmc
depth 32
wait on

[engines]
smtbmc z3

[script]
read -incdir . -formal formal_helpers.vh
read -incdir . -formal bus_pkg.vh
read -formal -D RSDG_ADMIT_GATE -D FORMAL security_config.v
read -formal -D RSDG_ADMIT_GATE -D FORMAL iopmp.v
read -formal -D RSDG_ADMIT_GATE rsdg.v
read -formal formal_sp11_rsdg_tb.v
prep -top formal_sp11_rsdg_tb

[files]
../../rtl/common/bus_pkg.vh
../../rtl/soc/security_config.v
../../rtl/iopmp/iopmp.v
../../rtl/soc/rsdg.v
../harness/formal_helpers.vh
../harness/formal_sp11_rsdg_tb.v
