[options]
mode prove
wait on

[engines]
smtbmc z3

[script]
read -incdir . -formal formal_helpers.vh
read -incdir . -formal bus_pkg.vh
read -formal -D FORMAL pmp.v
read -formal formal_bus_stub.v
read -formal formal_pmp_tb.v
prep -top formal_pmp_tb

